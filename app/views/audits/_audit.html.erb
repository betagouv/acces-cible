<% site = audit.site %>

<tr id="<%= dom_id(site, :audits_table) %>" class="ac-row-link">
  <th scope="row">
    <%= link_to(site.normalized_url.truncate(ApplicationHelper::TRUNCATION_LENGTH), site_path(site), class: "fr-link ac-row-link__above", "aria-label": t('.row_label', url: site.normalized_url)) %>
  </th>
  <% @displayed_columns.each do |column| %>
    <%= audit_cell(audit, column) %>
  <% end %>
</tr>
