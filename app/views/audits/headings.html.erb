<% content_for :wide_modal, true %>

<p class="fr-mb-1w"><%= @check.human_explanation %></p>
<p class="fr-text--sm fr-text-mention--grey"><%= t("checks.accessibility_page_heading.allowed_level_differences") %></p>

<% found_levels = found_heading_levels(@check) %>

<%= dsfr_table(caption: t(".caption"), html_attributes: { class: "fr-mb-0" }) do |table| %>
  <% table.with_head do %>
    <tr>
      <th scope="col"><%= t("checks.accessibility_page_heading.table_header") %></th>
      <th scope="col"><%= t(".found_level") %></th>
      <th scope="col"><%= t(".expected_level") %></th>
      <th scope="col"><%= t(".status") %></th>
    </tr>
  <% end %>
  <% table.with_body do %>
    <% @check.heading_statuses.each do |heading_status| %>
      <tr>
        <th scope="row" class="<%= class_names("fr-pl-4w" => heading_status.expected_level > 2) %>">
          <%= heading_status.expected_heading %>
          <% if heading_status.fuzzy_match? %>
            <p class="fr-text--sm fr-text-mention--grey fr-mb-0">
              <%= t("checks.accessibility_page_heading.retained") %>
              <cite><%= heading_status.actual_heading %></cite>
            </p>
          <% end %>
        </th>
        <td><%= found_level_badge(found_levels[heading_status.actual_heading]) %></td>
        <td><%= expected_level_badge(heading_status) %></td>
        <td><%= heading_status_badge(heading_status) %></td>
      </tr>
    <% end %>
  <% end %>
<% end %>
