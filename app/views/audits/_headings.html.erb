<%= dsfr_modal(title: t(".title"), html_attributes: { id: "headings-modal", class: "modal--wide" }) do %>
  <% page_levels = page_heading_levels(check) %>

  <p class="fr-mb-1w"><%= check.human_explanation %></p>
  <p class="fr-text--sm fr-text-mention--grey">
    <%= t(".description") %>
  </p>
  <% if notice = declaration_level_offset_notice(check) %>
    <p class="fr-text--sm fr-text-mention--grey"><%= notice %></p>
  <% end %>

  <% incorrect_order = check.heading_statuses.count(&:incorrect_order?) %>
  <% if incorrect_order.positive? %>
    <%= dsfr_alert(type: :warning, size: :sm, html_attributes: { class: "fr-mb-2w" }) do %>
      <p><%= t(".incorrect_order_alert", count: incorrect_order) %> <%= declaration_template_link %></p>
    <% end %>
  <% end %>

  <% incorrect_level = check.heading_statuses.count(&:incorrect_level?) %>
  <% if incorrect_level.positive? %>
    <%= dsfr_alert(type: :warning, size: :sm, html_attributes: { class: "fr-mb-2w" }) do %>
      <p><%= t(".incorrect_level_alert", count: incorrect_level) %> <%= declaration_template_link %></p>
    <% end %>
  <% end %>

  <%= dsfr_table(caption: t(".caption"), html_attributes: { class: "fr-mb-0" }) do |table| %>
    <% table.with_head do %>
      <tr>
        <th scope="col"><%= t("checks.accessibility_page_heading.table_header") %></th>
        <th scope="col"><%= t(".found_level") %></th>
        <th scope="col"><%= t(".expected_level") %></th>
        <th scope="col"><%= t(".status") %></th>
      </tr>
    <% end %>
    <% table.with_body do %>
      <% check.heading_statuses.each do |heading_status| %>
        <tr>
          <th scope="row" class="<%= class_names("fr-pl-4w" => heading_status.expected_level > 2) %>">
            <%= heading_status.expected_heading %>
            <% if heading_status.fuzzy_match? %>
              <p class="fr-text--sm fr-text-mention--grey fr-mb-0">
                <%= t("checks.accessibility_page_heading.retained") %>
                <cite><%= heading_status.actual_heading %></cite>
              </p>
            <% end %>
          </th>
          <td><%= found_level_badge(page_levels[heading_status.actual_heading]) %></td>
          <td><%= expected_level_badge(heading_status, offset: check.heading_offset) %></td>
          <td><%= heading_status_badge(heading_status) %></td>
        </tr>
      <% end %>
    <% end %>
  <% end %>
<% end %>
