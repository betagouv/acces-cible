<% query = request.query_parameters.except("page") %>
<%= dsfr_modal(title: t(".title"), html_attributes: { id: "filters-modal", class: "modal--wide" }) do |modal| %>
  <p class="fr-text--sm"><%= t(".description") %></p>

  <div class="fr-grid-row fr-grid-row--gutters">
    <% AuditColumns::GROUPS.each_slice(3) do |groups| %>
      <div class="fr-col-12 fr-col-md-6">
        <% groups.each do |group, group_columns| %>
          <% filter_columns = group_columns & AuditColumns::FILTERABLE %>
          <% next if filter_columns.empty? %>
          <h2 class="fr-h6"><%= t("audits.modals.columns.groups.#{group}") %></h2>
          <% filter_columns.each do |column| %>
            <fieldset class="fr-fieldset">
              <legend class="fr-fieldset__legend fr-text--regular"><%= t("audits.index.columns.#{column}") %></legend>
              <% audit_filter_options(column).each do |label, value| %>
                <% id = "filter_#{column}_#{value}" %>
                <div class="fr-fieldset__element">
                  <div class="fr-checkbox-group fr-checkbox-group--sm">
                    <%= check_box_tag "filter[#{column}][]", value, Array(params.dig(:filter, column)).include?(value.to_s), id:, form: "filters-form" %>
                    <%= label_tag id, label, class: "fr-label" %>
                  </div>
                </div>
              <% end %>
            </fieldset>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>

  <% modal.with_button do %>
    <li><%= link_to t(".reset"), audits_path(query.merge("filter" => query["filter"]&.except(*AuditColumns::FILTERABLE))), class: "fr-btn fr-btn--secondary" %></li>
    <li><%= dsfr_button(label: t(".apply"), html_attributes: { type: :submit, form: "filters-form" }) %></li>
  <% end %>
<% end %>
