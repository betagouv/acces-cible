<% reset_params = request.query_parameters.except("page").deep_dup %>
<% reset_params["filter"]&.except!(*AuditColumns::FILTERABLE) %>
<%= dsfr_modal(title: t(".title"), html_attributes: { id: "filters-modal", class: "modal--wide" }) do |modal| %>
  <p class="fr-text--sm"><%= t(".description") %></p>

  <div class="fr-grid-row fr-grid-row--gutters">
    <% AuditColumns::GROUPS.each_slice(3) do |groups| %>
      <div class="fr-col-12 fr-col-md-6">
        <% groups.each do |group, group_columns| %>
          <% filter_columns = group_columns & AuditColumns::FILTERABLE %>
          <% next if filter_columns.empty? %>
          <fieldset class="fr-fieldset fr-mb-4w">
            <legend class="fr-fieldset__legend"><%= t("audits.modals.columns.groups.#{group}") %></legend>
            <hr class="fr-hr fr-col-8">
            <% filter_columns.each do |column| %>
              <fieldset class="fr-segmented fr-segmented--sm fr-fieldset__element">
                <legend class="fr-segmented__legend"><%= t("audits.index.columns.#{column}") %></legend>
                <div class="fr-segmented__elements">
                  <% [[t(".all"), ""], *audit_filter_options(column)].each do |label, value| %>
                    <% id = "filter_#{column}_#{value.to_s.presence || 'all'}" %>
                    <div class="fr-segmented__element">
                      <%= radio_button_tag "filter[#{column}]", value, params.dig(:filter, column).to_s == value.to_s, id:, form: "filters-form" %>
                      <%= label_tag id, label, class: "fr-label" %>
                    </div>
                  <% end %>
                </div>
              </fieldset>
            <% end %>
          </fieldset>
        <% end %>
      </div>
    <% end %>
  </div>

  <% modal.with_button do %>
    <li><%= link_to t(".reset"), audits_path(reset_params), class: "fr-btn fr-btn--secondary" %></li>
    <li><%= dsfr_button(label: t(".apply"), html_attributes: { type: :submit, form: "filters-form" }) %></li>
  <% end %>
<% end %>
