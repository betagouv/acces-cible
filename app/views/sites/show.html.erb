<%= turbo_stream_from @site %>

<% content_for :breadcrumb do %>
  <%= dsfr_breadcrumbs do |b| %>
    <% b.with_breadcrumb(label: t("audits.show.breadcrumb_sites"), href: sites_path) %>
    <% b.with_breadcrumb(label: @site.normalized_url) %>
  <% end %>
<% end %>

<div class="fr-grid-row fr-grid-row--middle fr-grid-row--gutters fr-mb-1w">
  <div class="fr-col">
    <h1 class="fr-mb-0"><%= @site.normalized_url %> </h1>
  </div>
  <div class="fr-col-auto">
    <%= button_to t("shared.new_audit"), [@site, :audits], method: :post, class: "fr-btn" %>
  </div>
</div>
<div class="fr-text--sm fr-mb-3w">
  <%= external_link_to(@site.url, @site.url) %>
  <% if @site.tags.present? %>
    <%= muted_dash %>
    <% @site.tags.each do |tag| %>
      <%= dsfr_tag(title: tag.name, size: :sm) %>
    <% end %>
  <% end %>
</div>

<% if @last_audit %>
  <% if @last_audit.reachable.completed? && @last_audit.reachable.redirected? %>
    <%= dsfr_callout(icon_name: "arrow-right-line", html_attributes: { class: "fr-mb-3w" }) do %>
      <%= t("checks.reachable.redirect_message", original: @last_audit.reachable.original_url, redirected: @last_audit.reachable.redirect_url) %>
    <% end %>
  <% end %>

  <% if @last_audit.completed_at %>
    <%= render "audits/summary", audit: @last_audit %>
  <% else %>
    <%= dsfr_callout(title: t("audits.show.pending_title"), html_attributes: { class: "fr-mb-3w" }) do %>
      <%= t("audits.show.pending_text") %>
    <% end %>
  <% end %>
<% end %>

<h2 class="fr-h4"><%= t(".audit_history", total: @audits.size) %></h2>
<p class="fr-text--sm fr-mb-3w"><%= t(".audit_history_hint") %></p>

<div class="audit-timeline">
  <% @audits.each do |audit| %>
    <div class="audit-card fr-p-3w fr-mb-2w audit-timeline__row">
      <div class="audit-timeline__main">
        <p class="audit-timeline__date">
          <%= l(audit.created_at.in_time_zone, format: :long).upcase_first %>
          <% if audit == @audits.first %>
            <span class="fr-badge fr-badge--info fr-badge--sm fr-badge--no-icon"><%= t(".most_recent") %></span>
          <% end %>
        </p>
        <% if audit.user %>
          <p class="audit-timeline__team"><%= t("audits.show.launched_by", team: audit.user.team.organization_label) %></p>
        <% end %>
      </div>

      <% if audit.completed_at %>
        <div class="audit-timeline__stats">
          <div class="audit-timeline__stat">
            <span class="audit-timeline__stat-label"><%= t(".legal_obligations") %></span>
            <%= star_rating(filled: audit.legal_obligation_score.to_i, total: 4, color: "blue", label: t(".legal_obligations")) %>
          </div>
          <div class="audit-timeline__stat">
            <span class="audit-timeline__stat-label"><%= t("audits.show.summary_declaration_quality") %></span>
            <%= star_rating(filled: audit.declaration_quality_score.to_f, total: 4, color: "gold", label: t("audits.show.summary_declaration_quality")) %>
          </div>
        </div>
      <% else %>
        <p class="fr-badge fr-badge--info fr-badge--sm fr-badge--no-icon fr-mb-0"><%= t("audits.show.pending_title") %></p>
      <% end %>

      <div class="audit-timeline__actions">
        <%= link_to t(".see_result"), site_audit_path(@site, audit), class: "fr-btn fr-btn--secondary fr-btn--sm" %>
        <%= button_to [@site, :audits], method: :post, class: icon_class(:refresh, line: true, btn: :tertiary, size: :sm) do %>
          <span class="fr-sr-only"><%= t(".relaunch") %></span>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
