<% if @sites.load.any? %>
  <%= dsfr_table(caption: t('.caption')) do |t| %>
    <% t.with_head do %>
      <tr>
        <th scope="col" aria-sort="ascending"><%= t('.name') %></th>
      </tr>
    <% end %>
    <% t.with_body do %>
      <% @sites.each do |site| %>
        <tr>
          <td><%= dsfr_link_to site.normalized_url, site %></td>
        </tr>
      <% end %>
    <% end %>
  <% end %>
<% else %>
  <%= dsfr_alert(type: :info, title: t('.no_sites', count: @tag.sites_count), html_attributes: { class: "fr-mb-4w" }) %>
<% end %>

<%= page_actions do %>
  <%= dsfr_link_to t('.see_sites', tag: @tag.name, count: @tag.sites_count), audits_path(filter: { tag_id: @tag.id }), class: "fr-btn fr-btn--tertiary" %>
  <%= dsfr_link_to t("shared.back_to_list"), { controller: :tags, action: :index }, class: "fr-btn fr-btn--tertiary-no-outline" %>
<% end %>
