<% content_for :hero do %>
  <div class="fr-background-alt--blue-france fr-py-6w">
    <div class="fr-container">
      <% if authenticated? %>
        <h1 class="fr-mb-1w"><%= t(".greeting", name: current_user.name) %></h1>
        <p class="fr-text--lead fr-mb-3w"><%= t(".intro") %></p>

        <div class="fr-grid-row fr-grid-row--gutters">
          <div class="fr-col-12 fr-col-sm-6 fr-col-md-4 fr-col-lg-3">
            <section class="bordered-card fr-p-3w fr-background-default--grey">
              <dl class="fr-m-0">
                <dt class="home-stat__label fr-text--xs fr-text-mention--grey fr-mb-1v"><%= t(".audits_count_label") %></dt>
                <dd class="fr-h2 fr-pl-0 fr-mb-1v"><%= @audits_count %></dd>
                <% if @audits_this_week_count.positive? %>
                  <dd class="fr-text--xs fr-text-mention--grey fr-pl-0 fr-mb-0"><%= t(".audits_count_detail", count: @audits_this_week_count) %></dd>
                <% end %>
              </dl>
            </section>
          </div>
          <div class="fr-col-12 fr-col-sm-6 fr-col-md-4 fr-col-lg-3">
            <section class="bordered-card fr-p-3w fr-background-default--grey">
              <dl class="fr-m-0">
                <dt class="home-stat__label fr-text--xs fr-text-mention--grey fr-mb-1v"><%= t(".sites_count_label") %></dt>
                <dd class="fr-h2 fr-pl-0 fr-mb-1v"><%= @audited_sites_count %></dd>
                <dd class="fr-text--xs fr-text-mention--grey fr-pl-0 fr-mb-0"><%= t(".sites_count_detail", count: @audited_sites_count) %></dd>
              </dl>
            </section>
          </div>
        </div>

        <%= link_to t("audit_batches.new.title"), new_audit_batch_path, class: "fr-btn fr-mt-3w" %>
      <% else %>
        <div class="fr-grid-row fr-grid-row--gutters fr-grid-row--middle">
          <div class="fr-col-12 fr-col-lg-7">
            <%= dsfr_badge(status: :info, html_attributes: { class: "fr-badge--sm fr-mb-2w" }) { t(".public_badge") } %>
            <h1 class="fr-mb-1w"><%= t(".welcome") %></h1>
            <p class="fr-text--lead fr-mb-3w"><%= t(".public_intro") %></p>
            <%= dsfr_proconnect_button(target: omniauth_path(provider: :proconnect)) %>
          </div>
          <div class="fr-col-12 fr-col-lg-5">
            <%= image_tag "home-hero-illustration.png", alt: "", class: "fr-responsive-img" %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
<% end %>

<h2 class="fr-h4"><%= t(".what_title") %></h2>
<p class="fr-text--sm fr-mb-3w"><%= t(".what_intro") %></p>

<div class="fr-grid-row fr-grid-row--gutters fr-mb-5w">
  <div class="fr-col-12 fr-col-md-6">
    <div class="bordered-card fr-p-3w fr-background-default--grey">
      <%= star_rating(filled: 4, total: 4, color: "blue", label: t(".legal_obligations_title"), size: :l) %>
      <h3 class="fr-h6 fr-mt-2w fr-mb-1w"><%= t(".legal_obligations_title") %></h3>
      <p class="fr-text--sm fr-text-mention--grey fr-mb-0"><%= t(".legal_obligations_description") %></p>
    </div>
  </div>
  <div class="fr-col-12 fr-col-md-6">
    <div class="bordered-card fr-p-3w fr-background-default--grey">
      <%= star_rating(filled: 4, total: 4, color: "gold", label: t(".declaration_quality_title"), size: :l) %>
      <h3 class="fr-h6 fr-mt-2w fr-mb-1w"><%= t(".declaration_quality_title") %></h3>
      <p class="fr-text--sm fr-text-mention--grey fr-mb-0"><%= t(".declaration_quality_description") %></p>
    </div>
  </div>
</div>

<h2 class="fr-h4"><%= t(".how_it_works_title") %></h2>
<div class="fr-grid-row fr-grid-row--gutters fr-mb-5w">
  <div class="fr-col-12 fr-col-md-4">
    <%= render "pages/feature", number: 1, title: t(".step_addresses_title"), description: t(".step_addresses_description") %>
  </div>
  <div class="fr-col-12 fr-col-md-4">
    <%= render "pages/feature", number: 2, title: t(".step_evaluation_title"), description: t(".step_evaluation_description") %>
  </div>
  <div class="fr-col-12 fr-col-md-4">
    <%= render "pages/feature", number: 3, title: t(".step_fix_title"), description: t(".step_fix_description") %>
  </div>
</div>

<h2 class="fr-h4"><%= t(".result_example_title") %></h2>
<p class="fr-text--sm fr-mb-3w"><%= t(".result_example_intro") %></p>

<%= card_with_header(title: "numerique.gouv.fr", description: t(".result_example_tag")) do %>
  <div class="fr-grid-row fr-grid-row--gutters fr-mb-3w">
    <div class="fr-col-12 fr-col-md-4">
      <p class="fr-text--sm fr-text--bold fr-mb-1v"><%= t(".declared_level_title") %></p>
      <%= dsfr_badge(status: :new, no_icon: true) { t("checks.accessibility_mention.mentions.partiellement") } %>
      <p class="fr-text--xs fr-text-mention--grey fr-mb-0 fr-mt-1v"><%= t(".result_example_declared_level_detail") %></p>
    </div>
    <div class="fr-col-12 fr-col-md-4">
      <p class="fr-text--sm fr-text--bold fr-mb-1v"><%= t(".legal_obligations_title") %></p>
      <%= star_rating(filled: 3, total: 4, color: "blue", label: t(".legal_obligations_title"), size: :l) %>
      <p class="fr-text--xs fr-text-mention--grey fr-mb-0"><%= t(".result_example_legal_obligations_detail") %></p>
    </div>
    <div class="fr-col-12 fr-col-md-4">
      <p class="fr-text--sm fr-text--bold fr-mb-1v"><%= t(".declaration_quality_title") %></p>
      <%= star_rating(filled: 3, total: 4, color: "gold", label: t(".declaration_quality_title"), size: :l) %>
      <p class="fr-text--xs fr-text-mention--grey fr-mb-0"><%= t(".result_example_declaration_quality_detail") %></p>
    </div>
  </div>
  <p class="fr-text--sm fr-mb-0">
    <%= dsfr_badge(status: :info, html_attributes: { class: "fr-badge--sm fr-mr-1w" }) { t(".optional") } %>
    <%= t(".automated_tests_title") %> — <%= t(".automated_tests_description") %>
  </p>
<% end %>

<% unless authenticated? %>
  <div class="fr-grid-row fr-grid-row--gutters fr-mt-2w">
    <div class="fr-col-12 fr-col-lg-8">
      <div class="rounded fr-background-alt--blue-france fr-p-4w fr-p-md-6w">
        <h2 class="fr-h4 fr-mb-1w"><%= t(".public_cta_title") %></h2>
        <p class="fr-mb-3w"><%= t(".public_cta_intro") %></p>
        <%= dsfr_proconnect_button(target: omniauth_path(provider: :proconnect)) %>
      </div>
    </div>
  </div>
<% end %>
