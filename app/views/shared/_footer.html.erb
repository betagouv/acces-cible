<footer class="fr-footer" role="contentinfo" id="footer">
  <div class="fr-container">
    <div class="fr-footer__body">
      <div class="fr-footer__brand fr-enlarge-link">
        <a href="/" title="Retour à l’accueil du site - <%= t("global.service_name") %>">
          <p class="fr-logo">
            <%= t("global.sponsor_html") %>
          </p>
        </a>
      </div>
      <div class="fr-footer__content">
        <p class="fr-footer__content-desc"><%= t("global.service_description") %></p>
        <ul class="fr-footer__content-list">
          <li class="fr-footer__content-item">
            <%= external_link_to "https://legifrance.gouv.fr", "legifrance.gouv.fr", class: "fr-footer__content-link" %>
          </li>
          <li class="fr-footer__content-item">
            <%= external_link_to "https://info.gouv.fr", "info.gouv.fr", class: "fr-footer__content-link" %>
          </li>
          <li class="fr-footer__content-item">
            <%= external_link_to "https://service-public.fr", "service-public.fr", class: "fr-footer__content-link" %>
          </li>
          <li class="fr-footer__content-item">
            <%= external_link_to "https://data.gouv.fr", "data.gouv.fr", class: "fr-footer__content-link" %>
          </li>
        </ul>
      </div>
    </div>
    <div class="fr-footer__bottom">
      <ul class="fr-footer__bottom-list">
        <li class="fr-footer__bottom-item">
          <%= dsfr_link_to t("pages.plan.title"), plan_path, class: "fr-footer__bottom-link" %>
        </li>
        <li class="fr-footer__bottom-item">
          <%= dsfr_link_to t("pages.contact.title"), contact_path, class: "fr-footer__bottom-link" %>
        </li>
        <li class="fr-footer__bottom-item">
          <%= dsfr_link_to t("shared.accessibility_status"), accessibilite_path, class: "fr-footer__bottom-link" %>
        </li>
        <li class="fr-footer__bottom-item">
          <%= dsfr_link_to t("pages.mentions_legales.title"), mentions_legales_path, class: "fr-footer__bottom-link" %>
        </li>
        <li class="fr-footer__bottom-item">
          <%= dsfr_link_to t("shared.personal_data"), donnees_personnelles_path, class: "fr-footer__bottom-link" %>
        </li>
        <li class="fr-footer__bottom-item">
          <%= dsfr_link_to t("pages.cookies.title"), cookies_path, class: "fr-footer__bottom-link" %>
        </li>
        <li class="fr-footer__bottom-item">
          <%= external_link_to commit_url(current_version), t(".source_code", version: current_version.first(10)), class: "fr-footer__bottom-link" %>
        </li>
        <li class="fr-footer__bottom-item">
          <%= dsfr_link_to t("pages.display_mode.title"), display_mode_path, class: "fr-footer__bottom-link", icon_left: "theme-fill", size: "sm", "data-turbo-frame": :modal %>
        </li>
      </ul>
      <div class="fr-footer__bottom-copy">
        <p>Sauf mention contraire, tous les contenus de ce site sont sous
          <%= external_link_to "https://github.com/etalab/licence-ouverte/blob/master/LO.md", t(".open_licence"), class: "fr-footer__bottom-link" %>
        </p>
      </div>
    </div>
  </div>
</footer>
