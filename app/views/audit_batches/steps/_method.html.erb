<%# locals: (audit_batch:, step:) %>
<%= form_with(model: audit_batch, url: audit_batch.persisted? ? step_audit_batch_path(audit_batch, step) : audit_batches_path) do |f| %>
  <fieldset class="fr-fieldset">
    <legend class="fr-fieldset__legend fr-h4">
      <%= t(".legend") %>
    </legend>

    <%= render "audit_batches/steps/method_option", f:, kind: :manual,
          pictogram: "artwork/pictograms/digital/internet.svg" %>
    <%= render "audit_batches/steps/method_option", f:, kind: :csv_import, disabled: true,
          pictogram: "artwork/pictograms/document/document-add.svg" %>

    <% if audit_batch.errors[:kind].any? %>
      <div class="fr-messages-group" role="alert">
        <p class="fr-message fr-message--error"><%= audit_batch.errors.full_messages_for(:kind).to_sentence %></p>
      </div>
    <% end %>
  </fieldset>

  <%= render "audit_batches/step_actions", audit_batch:, step: %>
<% end %>
