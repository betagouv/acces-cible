<%# locals: (f:, audit_batch:, sites:) %>
<%= f.hidden_field :kind unless audit_batch.current_step == AuditBatch::METHOD_STEP %>
<%= f.hidden_field :run_axe_on_homepage unless audit_batch.current_step == AuditBatch::CHECKS_STEP %>
<% unless audit_batch.current_step == AuditBatch::URLS_STEP %>
  <% audit_batch.urls.each do |url| %>
    <%= f.hidden_field :urls, multiple: true, value: url, id: nil %>
  <% end %>
<% end %>
<% editable_site_urls = audit_batch.current_step == AuditBatch::SUMMARY_STEP ? sites.map(&:normalized_url) : [] %>
<% audit_batch.site_tag_names.each do |site_url, names| %>
  <% next if editable_site_urls.include?(site_url) %>

  <% names.each do |name| %>
    <%= hidden_field_tag "audit_batch[site_tag_names][#{site_url}][]", name, id: nil %>
  <% end %>
<% end %>
