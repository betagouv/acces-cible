<%# locals: (f:, audit_batch:, step:) %>
<%= f.hidden_field :kind unless step == "method" %>
<% unless step == "urls" %>
  <% audit_batch.urls.each do |url| %>
    <%= f.hidden_field :urls, multiple: true, value: url, id: nil %>
  <% end %>
<% end %>
<% unless step == "summary" %>
  <% audit_batch.site_tags.each do |site_url, attributes| %>
    <% Array(attributes[:tag_ids]).each do |tag_id| %>
      <%= hidden_field_tag "audit_batch[site_tags][#{site_url}][tag_ids][]", tag_id, id: nil %>
    <% end %>
    <%= hidden_field_tag "audit_batch[site_tags][#{site_url}][tags_attributes][name]", attributes.dig(:tags_attributes, :name), id: nil %>
  <% end %>
<% end %>
