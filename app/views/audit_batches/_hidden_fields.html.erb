<%# locals: (f:, audit_batch:, step:, sites:) %>
<%= f.hidden_field :kind unless step == "method" %>
<% unless step == "urls" %>
  <% audit_batch.urls.each do |url| %>
    <%= f.hidden_field :urls, multiple: true, value: url, id: nil %>
  <% end %>
<% end %>
<% editable_site_urls = step == "summary" ? sites.map(&:normalized_url) : [] %>
<% audit_batch.site_tag_names.each do |site_url, names| %>
  <% next if editable_site_urls.include?(site_url) %>

  <% names.each do |name| %>
    <%= hidden_field_tag "audit_batch[site_tag_names][#{site_url}][]", name, id: nil %>
  <% end %>
<% end %>
