<%# locals: (audit_batch:, step:) %>
<% previous_step = audit_batch.previous_step(step) %>
<div class="fr-mt-4w">
  <div class="fr-grid-row fr-grid-row--gutters">
    <div class="fr-col">
      <ul class="fr-btns-group fr-btns-group--inline-md fr-btns-group--icon-left">
        <li>
          <%= link_to t("shared.back"),
                previous_step ? step_audit_batch_path(audit_batch, previous_step) : sites_path,
                class: icon_class("arrow-left", line: true, btn: :secondary) %>
        </li>
      </ul>
    </div>
    <div class="fr-col">
      <ul class="fr-btns-group fr-btns-group--inline-md fr-btns-group--right fr-btns-group--icon-right">
        <li>
          <%= dsfr_button(
                label: t("shared.continue"),
                icon: "arrow-right-line",
                icon_position: :right,
                html_attributes: { type: "submit", data: { turbo_submits_with: t("shared.saving") } }) %>
        </li>
      </ul>
    </div>
  </div>
</div>
