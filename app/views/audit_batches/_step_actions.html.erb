<div class="fr-grid-row fr-grid-row--gutters fr-grid-row--reverse fr-mt-4w">
  <div class="fr-col">
    <ul class="fr-btns-group fr-btns-group--inline-md fr-btns-group--right fr-btns-group--icon-<%= @audit_batch.next_step ? "right" : "left" %>">
      <li>
        <% if @audit_batch.next_step %>
          <%= dsfr_button(
                label: t("shared.continue"),
                icon: "arrow-right-line",
                html_attributes: { type: "submit", name: "requested_step", value: @audit_batch.next_step, data: { turbo: false } }) %>
        <% else %>
          <%= dsfr_button(
                label: t("audit_batches.launch"),
                icon: "play-circle-line",
                html_attributes: { type: "submit", data: { turbo: false } }) %>
        <% end %>
      </li>
    </ul>
  </div>
  <div class="fr-col">
    <% if @audit_batch.previous_step %>
      <ul class="fr-btns-group fr-btns-group--inline-md">
        <li>
          <%= dsfr_button(
                label: t("shared.back"),
                level: :secondary,
                html_attributes: { type: "submit", name: "requested_step", value: @audit_batch.previous_step, formnovalidate: true, data: { turbo: false } }) %>
        </li>
      </ul>
    <% end %>
  </div>
</div>
