<%# locals: (step:, next_step:) %>
<% steps = AuditBatch::STEPS %>
<% previous_step = steps[steps.index(step) - 1] unless step == steps.first %>
<div class="fr-mt-4w">
  <div class="fr-grid-row fr-grid-row--gutters">
    <div class="fr-col">
      <ul class="fr-btns-group fr-btns-group--inline-md fr-btns-group--icon-left">
        <li>
          <% if previous_step %>
            <%= dsfr_button(
                  label: t("shared.back"),
                  icon: "arrow-left-line",
                  level: :secondary,
                  html_attributes: { type: "submit", name: "requested_step", value: previous_step, formnovalidate: true }) %>
          <% end %>
        </li>
      </ul>
    </div>
    <div class="fr-col">
      <ul class="fr-btns-group fr-btns-group--inline-md fr-btns-group--right fr-btns-group--icon-<%= next_step ? "right" : "left" %>">
        <li>
          <% if next_step %>
            <%= dsfr_button(
                  label: t("shared.continue"),
                  icon: "arrow-right-line",
                  icon_position: :right,
                  html_attributes: { type: "submit", name: "requested_step", value: next_step }) %>
          <% else %>
            <%= dsfr_button(
                  label: t("audit_batches.launch"),
                  icon: "play-circle-line",
                  html_attributes: { type: "submit" }) %>
          <% end %>
        </li>
      </ul>
    </div>
  </div>
</div>
