<%= turbo_stream_from @audit_batch %>

<% content_for :breadcrumb do %>
  <%= dsfr_breadcrumbs do |b| %>
    <% b.with_breadcrumb(label: t(".breadcrumb_home"), href: root_path) %>
    <% b.with_breadcrumb(label: page_title) %>
  <% end %>
  <h1><%= page_title %></h1>
<% end %>

<p><%= t("audit_batches.new.intro") %></p>

<div class="fr-grid-row fr-grid-row--center">
  <div class="fr-col-12 fr-col-md-10 fr-col-lg-8 fr-mt-4w">
    <div id="<%= dom_id(@audit_batch, :status) %>" role="status">
      <%= render "status", audit_batch: @audit_batch %>
    </div>

    <h2 class="fr-h5 fr-mb-1w"><%= t(".heading") %></h2>
    <p class="fr-text--sm"><%= t(".intro") %></p>

    <% if @audits.any? %>
      <p class="fr-text--bold">
        <span id="<%= dom_id(@audit_batch, :completed_audits_count) %>"><%= @audit_batch.completed_audits_count %></span>
        <%= t(".progress", count: @count) %>
      </p>
    <% else %>
      <p>
        <span class="loader fr-text-action-high--blue-france fr-mr-1w" aria-hidden="true"></span>
        <%= t(".creating") %>
      </p>
    <% end %>

    <ul class="fr-raw-list">
      <% @audits.each do |audit| %>
        <% site = audit.site %>
        <li class="bordered-card bordered-card--link fr-p-2w fr-mb-2w">
          <span id="<%= dom_id(audit, :status) %>" class="audit-batch-status">
            <%= render "audit_status", audit: %>
          </span>
          <%= site_link(site) %>
          <%= link_to site_audit_path(site, audit), class: "ac-row-link__stretched" do %>
            <span class="fr-sr-only"><%= t(".see_audit", url: site.normalized_url) %></span>
          <% end %>
        </li>
      <% end %>
    </ul>

    <% if @pagy.last > 1 %>
      <div class="fr-table__footer">
        <%= render "shared/pagination" %>
      </div>
    <% end %>

    <ul class="fr-btns-group fr-btns-group--inline-md fr-mt-3w">
      <li><%= link_to t(".see_audits"), audits_path, class: "fr-btn" %></li>
      <li><%= link_to t(".launch_more"), new_audit_batch_path, class: "fr-btn fr-btn--secondary" %></li>
    </ul>
  </div>
</div>
