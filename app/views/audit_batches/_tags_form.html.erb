<%# locals: (site:, audit_batch:, tags:, add_tags_url:) %>
<% id = "site_tags_#{site.normalized_url.parameterize}" %>
<% title = t("audit_batches.steps.summary.tags", site: site.normalized_url) %>
<% field_name = "audit_batch[site_tag_names][#{site.normalized_url}][]" %>
<% selected_names = Array(audit_batch.site_tag_names[site.normalized_url]) %>
<% focus = audit_batch.new_tag_names[site.normalized_url].present? %>
<%= turbo_frame_tag id do %>
  <%= dsfr_accordion_section(title:, expanded: focus, header_level: 2, html_attributes: { class: "fr-mb-2w" }) do %>
    <fieldset class="fr-fieldset fr-legend--hidden">
      <legend class="fr-fieldset__legend fr-fieldset__legend--regular"><%= title %></legend>
      <%= hidden_field_tag field_name, "", id: nil %>

      <% (tags.map(&:name) | selected_names).each_with_index do |name, index| %>
        <% checkbox_id = "#{id}_#{index}" %>
        <div class="fr-fieldset__element">
          <div class="fr-checkbox-group">
            <%= check_box_tag field_name, name, selected_names.include?(name), id: checkbox_id %>
            <%= label_tag checkbox_id, name, class: "fr-label" %>
          </div>
        </div>
      <% end %>
    </fieldset>

    <div class="fr-input-group--inline fr-mb-0">
      <div class="fr-input-group fr-mb-0">
        <%= label_tag "#{id}_new", t("audit_batches.steps.summary.new_tag"), class: "fr-label" %>
        <%= text_field_tag "audit_batch[new_tag_names][#{site.normalized_url}]", nil, id: "#{id}_new", class: "fr-input" %>
      </div>
      <%= dsfr_button(
            label: t("shared.add"),
            level: :secondary,
            icon: "add-circle-line",
            html_attributes: { type: "submit", name: "add_tags", value: site.normalized_url, formaction: add_tags_url, formnovalidate: true, data: { turbo_frame: id } }) %>
    </div>
    <%= set_focus("#{id}_new") if focus %>
  <% end %>
<% end %>
