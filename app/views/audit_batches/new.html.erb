<p><%= t("audit_batches.new.intro") %></p>

<div class="fr-grid-row fr-grid-row--center">
  <div class="fr-col-12 fr-col-md-10 fr-col-lg-8 fr-border-default--grey fr-p-4w fr-mt-4w">
    <%= dsfr_stepper(
          title: t("audit_batches.steps.#{@step}.title"),
          value: AuditBatch::STEPS.index(@step) + 1,
          max: AuditBatch::STEPS.size,
          next_title: (t("audit_batches.steps.#{@next_step}.title") if @next_step),
          header_level: 2) %>

    <%= form_with(model: @audit_batch) do |f| %>
      <%= render "audit_batches/hidden_fields", f:, audit_batch: @audit_batch, step: @step, sites: @sites %>
      <%= render "audit_batches/steps/#{@step}", f:, audit_batch: @audit_batch %>
      <%= render "audit_batches/step_actions" %>
    <% end %>
  </div>
</div>
